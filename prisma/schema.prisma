generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URI")
}

enum Role {
  ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model Profile {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  key          String   @unique @default("default")
  fullName     String
  headline     String
  bio          String
  location     String?
  email        String?
  phone        String?
  profileImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SocialLink {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  platform  String
  url       String
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platform])
}

model Project {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String        @unique
  summary     String
  description String
  techStack   String[]
  imageUrl    String?
  githubUrl   String?
  liveUrl     String?
  featured    Boolean       @default(false)
  status      ContentStatus @default(DRAFT)
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, featured])
  @@index([createdAt])
}

model Achievement {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String        @unique
  issuer      String?
  description String
  date        DateTime?
  imageUrl    String?
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
}

model Certification {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  slug          String        @unique
  issuer        String
  issueDate     DateTime?
  credentialUrl String?
  imageUrl      String?
  status        ContentStatus @default(PUBLISHED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
}

model Education {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String        @unique
  institution String
  startYear   Int?
  endYear     Int?
  score       String?
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
}

model Skill {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  category    String
  proficiency Int      @default(80)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model Experience {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  company     String
  role        String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  current     Boolean       @default(false)
  description String
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, startDate])
}

model BlogPost {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  slug          String        @unique
  excerpt       String
  markdown      String
  coverImageUrl String?
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, publishedAt])
}

model Resume {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fileUrl   String
  fileName  String
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
